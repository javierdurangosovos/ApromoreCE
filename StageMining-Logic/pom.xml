<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apromore</groupId>
        <artifactId>community</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>stagemining-logic</artifactId>
    <packaging>bundle</packaging>
    <name>Stage Mining Service</name>
    <version>1.1</version>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <unpackBundle>false</unpackBundle> <!-- This is important so that embedded JAR's don't show up twice -->
                    <instructions>
                        <Embed-Dependency>
                            groupId=org.apache.derby;artifactId=derby
                        </Embed-Dependency>
                        <Embed-Transitive>false</Embed-Transitive>
                        <Import-Package>
                            org.springframework.beans.factory.aspectj,
                            org.springframework.*;version="[3.1.0,4.0.0)",
                            !com.ibm.db2.jcc,
                            !org.apache.derby.jdbc,
                            !org.apache.derby.*,
                            !org.apache.xpath,
                            !org.apache.xpath.*,
                            !org.apache.xalan,
                            !org.apache.xalan.*,
                            !org.apache.xml.utils,
                            !org.apache.xml.utils.*,
                            *
                        </Import-Package>
                        <Export-Package>
                            org.apromore.service.stagemining,
                            org.processmining.stagemining.models,
                            org.processmining.stagemining.models.graph,
                            org.processmining.stagemining.utils,
                            org.processmining.stagemining.algorithms
                        </Export-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.apromore</groupId>
            <artifactId>log-osgi</artifactId>
        </dependency>
            
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.apache.servicemix.bundles</groupId>
            <artifactId>org.apache.servicemix.bundles.joda-time</artifactId>
            <version>2.3_1</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-math3</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.derby</groupId>
            <artifactId>derby</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.jbpt</groupId>
            <artifactId>jbpt-core</artifactId>
        </dependency>      
        
        <dependency>
        	<groupId>org.jbpt</groupId>
            <artifactId>jbpt-deco</artifactId>
        </dependency>
    </dependencies>
   
</project>

